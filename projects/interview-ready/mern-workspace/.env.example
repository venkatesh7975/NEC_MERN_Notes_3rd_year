MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=mern_interview_workspace
PORT=3000
# During Vite development use http://localhost:5173 instead.
APP_ORIGIN=http://localhost:3000
NODE_ENV=production
# Optional signed test adapter, never a real payment-provider secret.
# PAYMENT_TEST_SECRET=replace-with-a-local-test-secret
# Only enable with NODE_ENV=development. No money moves.
ENABLE_PAYMENT_SIMULATOR=false
